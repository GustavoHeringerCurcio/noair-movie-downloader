# Copy this file to .env and fill in real values. Never commit .env.
# See docs/credentials.md for where to get each value.

# TMDB — free API key, https://www.themoviedb.org -> Settings -> API
TMDB_API_KEY=your_tmdb_api_key

# OMDb — OPTIONAL free key, https://www.omdbapi.com -> your API key (email).
# Supplies the true IMDb score for the hover-card / Detail ratings chips
# (T-004; captured while resolving the /api/images/art/:type/:id/poster row).
# Displayed poster art comes from the TMDB key alone (S8 proxy), so leave this
# empty to hide the IMDb rating chips without losing any artwork.
OMDB_API_KEY=

# fanart.tv — OPTIONAL free key, https://fanart.tv -> login -> API -> Personal
# API Key. Supplies the real 16:9 key-art thumbnails for Horizontal poster cards
# (T-002, the opt-in mode; the default Vertical 2:3 cards use raw TMDB posters):
# moviethumb (movie) / tvthumb (TV). Art is downloaded once by the backend to
# the art volume and served from /api/images/fanart/*. Leave empty to always
# render the backdrop + logo / typography fallback on Horizontal cards.
FANART_API_KEY=

# Prowlarr — the prowlarr container pins this key into its config.xml on every
# boot (deploy/prowlarr-api-key.sh), so it always matches the backend.
# Optional: set 0 to disable automatic indexer creation on backend start.
# Optional: comma-separated names to auto-create (defaults below). 1337x is
# Cloudflare-protected and may fail unless Prowlarr can reach it.
PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY=your_prowlarr_api_key
PROWLARR_BOOTSTRAP_INDEXERS=1
PROWLARR_BOOTSTRAP_INDEXERS_LIST=YTS,LimeTorrents,TorrentDownload,1337x

# qBittorrent Web UI credentials (set on first login)
QBITTORRENT_URL=http://qbittorrent:8080
QBITTORRENT_USER=admin
QBITTORRENT_PASS=your_qbit_password

# PostgreSQL (self-contained in docker-compose; change locally if desired)
DATABASE_URL=postgres://app:app@postgres:5432/moviedl

# Shared downloads volume mount point (must match docker-compose.yml)
DOWNLOAD_DIR=/downloads

# Optional — local artwork cache volume for the poster/key-art/logo files (T-002).
# The backend downloads poster, fanart key-art and TMDB logo files here once and
# serves them from /api/images/art/* (S8b) and /api/images/fanart/* (S8c). A
# named volume is mounted at /art by default.
ART_DIR=/art

# Backend HTTP port
PORT=3000

# Package cache (D26/D27) — soft size cap in bytes for the /packages volume.
# Oldest completed packages are evicted beyond this; compat H.264 packages are
# ~1.0x the source size. Default 50 GiB (53687091200).
PACKAGE_MAX_BYTES=53687091200

# Remote access (beta, D28) — opt-in Cloudflare tunnel so you can watch from a
# TV / other device. Set 1, then `docker compose --profile remote up -d cloudflared`.
REMOTE_ACCESS=0

# Named tunnel (optional). Empty = quick tunnel (ephemeral *.trycloudflare.com
# URL, changes on restart). Set CLOUDFLARE_TUNNEL_TOKEN (from the Cloudflare
# Zero Trust dashboard) and CLOUDFLARE_TUNNEL_HOSTNAME (your domain) for a stable URL.
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_TUNNEL_HOSTNAME=
